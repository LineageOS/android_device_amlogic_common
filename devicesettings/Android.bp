android_app {
    name: "DeviceSettings",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,
    static_libs: [
        "org.lineageos.platform.internal",
        "org.lineageos.settings.resources",
        "SettingsLib",
        "droidlogic",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}
